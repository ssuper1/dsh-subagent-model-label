{
  "name": "dsh-subagent-model-label",
  "description": "Show each subagent's provider group and model in the DSH subagent catalog",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "ssuper1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssuper1/dsh-subagent-model-label.git"
  },
  "homepage": "https://github.com/ssuper1/dsh-subagent-model-label#readme",
  "bugs": {
    "url": "https://github.com/ssuper1/dsh-subagent-model-label/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "subagent",
    "ui"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "preview": "node tests/render-fixture.mjs"
  }
}
